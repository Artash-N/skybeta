# sim/px4_sitl.env -- environment for a hand-launched PX4 v1.16.2 SITL instance.
#
#   cd ~/PX4-Autopilot
#   source /path/to/skybeta/sim/px4_sitl.env
#   mkdir -p "$PX4_RUN_DIR" && cd "$PX4_RUN_DIR"
#   "$PX4_SITL_BIN" "$PX4_ROMFS" -s "$PX4_RC_SCRIPT" -i 0
#
# Launching PX4 by hand (rather than letting Pegasus's px4_autolaunch do it) is
# deliberate: Pegasus's PX4LaunchTool runs px4 with
# cwd=tempfile.TemporaryDirectory(), so parameters.bson is written into a
# directory that is deleted with the process. `param save` there is a no-op
# across restarts, and every EKF2 setting in sim/README.md has to be re-typed on
# each run. Running from a fixed PX4_RUN_DIR makes them stick.
#
# Note there is no `-d`: without it you get the interactive `pxh>` prompt, which
# is where you type the `param set` lines. Pegasus passes -d because it has no
# console to give you.
#
# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
export PX4_DIR="${PX4_DIR:-$HOME/PX4-Autopilot}"
export PX4_SITL_BIN="${PX4_DIR}/build/px4_sitl_default/bin/px4"
export PX4_ROMFS="${PX4_DIR}/ROMFS/px4fmu_common/"
export PX4_RC_SCRIPT="${PX4_DIR}/ROMFS/px4fmu_common/init.d-posix/rcS"

# Persistent working directory. rcS does `param select parameters.bson` relative
# to cwd, so this is where saved parameters live.
export PX4_RUN_DIR="${PX4_RUN_DIR:-$HOME/.skybeta/px4_sitl_run}"

# ---------------------------------------------------------------------------
# Airframe / simulator selection
# ---------------------------------------------------------------------------
# rcS resolves this to ROMFS/px4fmu_common/init.d-posix/airframes/<id>_<model>;
# `gazebo-classic_iris` is 10015 in v1.16.2 (verified present at that tag). Its
# autostart routes through px4-rc.simulator -> px4-rc.mavlinksim, i.e.
# `simulator_mavlink start -c 4560` -- a TCP *server* on 4560 + instance, which is
# exactly what Pegasus's PX4MavlinkBackend (connection_type "tcpin", baseport
# 4560) connects to. Nothing about the name makes Gazebo run; no Gazebo is
# installed and none is started.
export PX4_SIM_MODEL="${PX4_SIM_MODEL:-gazebo-classic_iris}"

# ---------------------------------------------------------------------------
# uXRCE-DDS
# ---------------------------------------------------------------------------
# rcS starts `uxrce_dds_client start -t udp -p $uxrce_dds_port` unconditionally,
# defaulting to 8888 and honouring PX4_UXRCE_DDS_PORT. It also copies
# ROS_DOMAIN_ID into the UXRCE_DDS_DOM_ID parameter, so exporting ROS_DOMAIN_ID
# here is how the SITL client and the container's agent end up on the same DDS
# domain -- there is no parameter to set by hand.
export PX4_UXRCE_DDS_PORT="${PX4_UXRCE_DDS_PORT:-8888}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"

# MAV_1_CONFIG and UXRCE_DDS_CFG DO NOT APPLY HERE. Those select a *serial port*
# (102 = TELEM 2) and exist so that, on the airframe, MAVLink and uXRCE-DDS do not
# both claim one UART. SITL's client is a UDP client that rcS starts directly,
# never through the serial-port arbitration, and SER_TEL2_BAUD is equally
# meaningless. The "one port, one owner" rule in CLAUDE.md is a hardware rule;
# do not port it into the sim and then wonder why setting UXRCE_DDS_CFG=102
# changes nothing.

# ---------------------------------------------------------------------------
# Parameters to set once at the pxh> prompt, then `param save`
# ---------------------------------------------------------------------------
# UXRCE_DDS_SYNCT=0 is the important one and it is reboot-gated:
# uxrce_dds_client.cpp reads it once, into _synchronize_timestamps, when the
# client starts. Setting it at the prompt does nothing until the client is
# restarted. Either restart PX4 after `param save`, or restart just the client:
#
#     param set UXRCE_DDS_SYNCT 0
#     param save
#     uxrce_dds_client stop
#     uxrce_dds_client start -t udp -p 8888
#
# Why it matters: Pegasus runs PX4 in lockstep, so PX4's clock advances with the
# renderer, not with the wall clock. A 1280x800 stereo pair at 30 Hz will not hold
# real time on every machine. With timestamp sync on, the client keeps correcting
# PX4 time towards the agent's host clock, and every /fmu/* stamp inherits that
# drift -- which then lands in EKF2_EV_DELAY's budget as noise you cannot tune out.
#
# The rest are the sim equivalents of the EKF2 block in CLAUDE.md, GPS-denied:
#
#     param set UXRCE_DDS_SYNCT 0     # see above
#     param set EKF2_EV_CTRL     9    # bit 0 horiz pos + bit 3 yaw
#     param set EKF2_EV_DELAY    50   # ms; MEASURE it, see tools/latency_probe.py
#     param set EKF2_EV_NOISE_MD 0    # trust the variances the bridge publishes
#     param set EKF2_HGT_REF     0    # Baro
#     param set EKF2_BARO_CTRL   1    # baro fusion on -- HGT_REF=0 with this off
#                                     # leaves no height aiding at all
#     param set EKF2_GPS_CTRL    0    # GPS-denied. Pegasus publishes a perfect
#                                     # HIL_GPS; leaving this on lets EKF2 lean on
#                                     # it and the vision path looks better than
#                                     # it is.
#     param set EKF2_OF_CTRL     0    # no optical flow in this rig
#     param set EKF2_RNG_CTRL    0    # no rangefinder in this rig
#     param set COM_RCL_EXCEPT   4    # SITL has no RC transmitter; without this,
#                                     # RC-loss failsafe fires the moment you try
#                                     # to arm for an offboard test
#     param save
#
# Change one thing at a time and re-test. `param show EKF2_EV_CTRL` reads back.
